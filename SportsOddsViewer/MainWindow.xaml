<Window x:Class="SportsOddsViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sports Odds Viewer - Cập nhật tự động mỗi giây" Height="800" Width="1600"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Style for DataGrid -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#F0F8FF"/>
            <Setter Property="BorderBrush" Value="#2E5090"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#E8F4FF"/>
        </Style>

        <!-- Style for DataGrid Column Headers -->
        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4169E1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Style for DataGrid Cells -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE87A"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Odds Text (Red/Blue numbers) -->
        <Style x:Key="OddsTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2E5090" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚽ Sports Odds Viewer" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LastUpdateText" 
                               Text="Đang tải..." 
                               Foreground="#FFD700" 
                               FontSize="12" 
                               Margin="20,0,0,0" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="RefreshButton" 
                        Grid.Column="1"
                        Content="🔄 Làm mới ngay" 
                        Background="#32CD32" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Padding="15,5" 
                        Margin="0,0,10,0"
                        Click="RefreshButton_Click" 
                        Cursor="Hand"/>

                <ToggleButton x:Name="AutoUpdateToggle" 
                              Grid.Column="2"
                              Content="⏸ Tạm dừng" 
                              IsChecked="True"
                              Background="#FF6347" 
                              Foreground="White" 
                              FontWeight="Bold"
                              Padding="15,5"
                              Click="AutoUpdateToggle_Click" 
                              Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Data Grid with Custom Column Groups -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Custom Header Row 1 (Main Groups) -->
            <Border Grid.Row="0" Background="#4169E1" BorderBrush="#2E5090" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>   <!-- Thời Gian -->
                        <ColumnDefinition Width="200"/>  <!-- Trận đấu -->
                        <ColumnDefinition Width="400"/>  <!-- Nguyên trận -->
                        <ColumnDefinition Width="80"/>   <!-- Lẻ/Chẵn -->
                        <ColumnDefinition Width="300"/>  <!-- Hiệp 1 -->
                        <ColumnDefinition Width="80"/>   <!-- Nhiều -->
                    </Grid.ColumnDefinitions>
                    
                    <TextBlock Grid.Column="0" Text="Thời Gian" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Grid.Column="1" Text="Trận đấu" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Grid.Column="2" Text="Nguyên trận" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Grid.Column="3" Text="Lẻ/Chẵn" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Grid.Column="4" Text="Hiệp 1" Style="{StaticResource HeaderTextStyle}"/>
                    <TextBlock Grid.Column="5" Text="Nhiều" Style="{StaticResource HeaderTextStyle}"/>
                </Grid>
            </Border>
            
            <!-- DataGrid with Sub-headers -->
            <DataGrid x:Name="MatchesDataGrid" 
                      Grid.Row="1" 
                      Style="{StaticResource DataGridStyle}"
                      CellStyle="{StaticResource CellStyle}"
                      ItemsSource="{Binding}">
                
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#5B89E1"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Height" Value="30"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="3"/>
                        <Setter Property="BorderBrush" Value="#2E5090"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                
                <DataGrid.Columns>
                    <!-- Thời Gian -->
                    <DataGridTextColumn Header="" Binding="{Binding Time}" Width="80"/>
                    
                    <!-- Trận đấu -->
                    <DataGridTemplateColumn Header="" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical" Margin="5,2">
                                    <TextBlock Text="{Binding League}" 
                                              FontSize="9" 
                                              Foreground="Gray"
                                              TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding HomeTeam}" 
                                              FontWeight="SemiBold"
                                              FontSize="11"
                                              Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding AwayTeam}" 
                                              FontWeight="SemiBold"
                                              FontSize="11"
                                              Margin="0,1,0,0"/>
                                    <TextBlock Text="{Binding Status}" 
                                              FontSize="9" 
                                              Foreground="Red"
                                              FontWeight="Bold"
                                              Margin="0,2,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Live">
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Sắp diễn ra">
                                                        <Setter Property="Foreground" Value="Green"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- NGUYÊN TRẬN -->
                    
                    <!-- Cược chấp (FT) -->
                    <DataGridTemplateColumn Header="Cược chấp" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding FTHDPLine}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FTHDPHome}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding FTHDPLineAway}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FTHDPAway}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tài/Xỉu (FT) -->
                    <DataGridTemplateColumn Header="Tài/Xỉu" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding FTOULine}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FTOUOver}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding FTOULineUnder}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding FTOUUnder}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 1X2 (FT) -->
                    <DataGridTemplateColumn Header="1X2" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                              Text="{Binding FT1X2Home}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" 
                                              Text="{Binding FT1X2Draw}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" 
                                              Text="{Binding FT1X2Away}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Lẻ/Chẵn -->
                    <DataGridTemplateColumn Header="Lẻ/Chẵn" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Vertical">
                                    <TextBlock Text="{Binding OddEvenOdd}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding OddEvenEven}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- HIỆP 1 -->
                    
                    <!-- Cược chấp (HT) -->
                    <DataGridTemplateColumn Header="Cược chấp" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding HTHDPLine}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding HTHDPHome}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding HTHDPLineAway}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding HTHDPAway}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Tài/Xỉu (HT) -->
                    <DataGridTemplateColumn Header="Tài/Xỉu" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Orientation="Vertical">
                                        <TextBlock Text="{Binding HTOULine}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding HTOUOver}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Vertical">
                                        <TextBlock Text="{Binding HTOULineUnder}" 
                                                  Foreground="#0066CC" 
                                                  FontSize="10"
                                                  FontWeight="Bold"
                                                  HorizontalAlignment="Center"/>
                                        <TextBlock Text="{Binding HTOUUnder}" 
                                                  Foreground="Black" 
                                                  FontSize="11"
                                                  FontWeight="SemiBold"
                                                  HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 1X2 (HT) -->
                    <DataGridTemplateColumn Header="1X2" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" 
                                              Text="{Binding HT1X2Home}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" 
                                              Text="{Binding HT1X2Draw}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" 
                                              Text="{Binding HT1X2Away}" 
                                              Foreground="Black" 
                                              FontSize="11"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Nhiều -->
                    <DataGridTemplateColumn Header="+" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="+" 
                                          FontSize="16"
                                          FontWeight="Bold"
                                          Foreground="#4169E1"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#2E5090" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" 
                           Text="Đang kết nối..." 
                           Foreground="White" 
                           VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" 
                           x:Name="MatchCountText" 
                           Text="Số trận: 0" 
                           Foreground="#FFD700" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
