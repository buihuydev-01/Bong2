<Window x:Class="SportsOddsViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sports Odds Viewer - Cập nhật tự động mỗi giây" Height="800" Width="1600"
        WindowStartupLocation="CenterScreen">
    
    <Window.Resources>
        <!-- Style for DataGrid -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#F0F8FF"/>
            <Setter Property="BorderBrush" Value="#2E5090"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="VerticalGridLinesBrush" Value="#D0D0D0"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#E8F4FF"/>
        </Style>

        <!-- Style for DataGrid Column Headers -->
        <Style x:Key="ColumnHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#4169E1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5"/>
        </Style>

        <!-- Style for DataGrid Cells -->
        <Style x:Key="CellStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,0"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#FFE87A"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Style for Odds Text (Red/Blue numbers) -->
        <Style x:Key="OddsTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2E5090" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="⚽ Sports Odds Viewer" 
                               Foreground="White" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="LastUpdateText" 
                               Text="Đang tải..." 
                               Foreground="#FFD700" 
                               FontSize="12" 
                               Margin="20,0,0,0" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="RefreshButton" 
                        Grid.Column="1"
                        Content="🔄 Làm mới ngay" 
                        Background="#32CD32" 
                        Foreground="White" 
                        FontWeight="Bold"
                        Padding="15,5" 
                        Margin="0,0,10,0"
                        Click="RefreshButton_Click" 
                        Cursor="Hand"/>

                <ToggleButton x:Name="AutoUpdateToggle" 
                              Grid.Column="2"
                              Content="⏸ Tạm dừng" 
                              IsChecked="True"
                              Background="#FF6347" 
                              Foreground="White" 
                              FontWeight="Bold"
                              Padding="15,5"
                              Click="AutoUpdateToggle_Click" 
                              Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Data Grid -->
        <DataGrid x:Name="MatchesDataGrid" 
                  Grid.Row="1" 
                  Style="{StaticResource DataGridStyle}"
                  ColumnHeaderStyle="{StaticResource ColumnHeaderStyle}"
                  CellStyle="{StaticResource CellStyle}"
                  ItemsSource="{Binding}">
            
            <DataGrid.Columns>
                <!-- Time -->
                <DataGridTextColumn Header="Thời Gian" Binding="{Binding Time}" Width="80"/>
                
                <!-- Status -->
                <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="Live">
                                    <Setter Property="Foreground" Value="Red"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- League -->
                <DataGridTextColumn Header="Giải đấu" Binding="{Binding League}" Width="200"/>

                <!-- Home Team -->
                <DataGridTextColumn Header="Đội nhà" Binding="{Binding HomeTeam}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Away Team -->
                <DataGridTextColumn Header="Đội khách" Binding="{Binding AwayTeam}" Width="180">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="TextAlignment" Value="Left"/>
                            <Setter Property="Padding" Value="10,0,0,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Handicap (HDP) -->
                <DataGridTemplateColumn Header="Cược chấp" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding OddsHDPHome}" 
                                          Foreground="Red" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                                <TextBlock Text="{Binding OddsHDPAway}" 
                                          Foreground="Blue" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Over/Under (OU) -->
                <DataGridTemplateColumn Header="Tài/Xỉu" Width="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="{Binding OddsOUOver}" 
                                          Foreground="Red" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                                <TextBlock Text="{Binding OddsOUUnder}" 
                                          Foreground="Blue" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- 1X2 Odds -->
                <DataGridTemplateColumn Header="1X2" Width="150">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" 
                                          Text="{Binding Odds1X2Home}" 
                                          Foreground="Red" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                                <TextBlock Grid.Column="1" 
                                          Text="{Binding Odds1X2Draw}" 
                                          Foreground="Green" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                                <TextBlock Grid.Column="2" 
                                          Text="{Binding Odds1X2Away}" 
                                          Foreground="Blue" 
                                          Style="{StaticResource OddsTextStyle}"
                                          FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <!-- Event ID (Hidden column for reference) -->
                <DataGridTextColumn Header="ID" Binding="{Binding EventId}" Width="80" Visibility="Collapsed"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#2E5090" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <TextBlock x:Name="StatusText" 
                           Text="Đang kết nối..." 
                           Foreground="White" 
                           VerticalAlignment="Center"/>
                
                <TextBlock Grid.Column="1" 
                           x:Name="MatchCountText" 
                           Text="Số trận: 0" 
                           Foreground="#FFD700" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
