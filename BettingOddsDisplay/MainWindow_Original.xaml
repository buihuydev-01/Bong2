<Window x:Class="BettingOddsDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BettingOddsDisplay"
        xmlns:converters="clr-namespace:BettingOddsDisplay.Converters"
        mc:Ignorable="d"
        Title="Betting Odds Display" Height="800" Width="1400"
        Background="#E8EDF2">
    
    <Window.Resources>
        <converters:OddsColorConverter x:Key="OddsColorConverter"/>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
        
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        
        <Style x:Key="CellTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
        
        <Style x:Key="OddsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CellTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Status Bar -->
        <Border Grid.Row="0" Background="#2E5090" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Cập nhật tự động mỗi giây" Foreground="White" FontWeight="Bold"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Cập nhật lúc: " Foreground="White"/>
                    <TextBlock x:Name="UpdateTimeText" Text="--:--:--" Foreground="Yellow" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl x:Name="LeaguesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#B0C4D8" BorderThickness="0,0,0,1" Margin="0,0,0,10">
                            <!-- League Header -->
                            <StackPanel>
                                <Border Background="#4A6FA5" Padding="5">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" Foreground="White" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text=" ⚽" Foreground="White" Margin="5,0"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Table Header -->
                                <Border Background="#2E5090" BorderBrush="#1E3F70" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>  <!-- Thời Gian -->
                                            <ColumnDefinition Width="200"/> <!-- Trận đấu -->
                                            <ColumnDefinition Width="280"/> <!-- Cược chấp -->
                                            <ColumnDefinition Width="130"/> <!-- Tài/Xỉu -->
                                            <ColumnDefinition Width="130"/> <!-- 1X2 -->
                                            <ColumnDefinition Width="280"/> <!-- Hiệp 1 Cược chấp -->
                                            <ColumnDefinition Width="130"/> <!-- Hiệp 1 Tài/Xỉu -->
                                            <ColumnDefinition Width="130"/> <!-- Hiệp 1 1X2 -->
                                            <ColumnDefinition Width="60"/>  <!-- Nhiều -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Headers -->
                                        <TextBlock Grid.Column="0" Text="Thời Gian" Style="{StaticResource HeaderTextStyle}"/>
                                        
                                        <Border Grid.Column="1" BorderBrush="#3A5A9A" BorderThickness="1,0,1,0">
                                            <TextBlock Text="Trận đấu" Style="{StaticResource HeaderTextStyle}"/>
                                        </Border>
                                        
                                        <Border Grid.Column="2" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Nguyên trận" Style="{StaticResource HeaderTextStyle}" Margin="0,2"/>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Cược chấp" Style="{StaticResource HeaderTextStyle}" FontSize="10"/>
                                                    <TextBlock Grid.Column="1" Text="Tài/Xỉu" Style="{StaticResource HeaderTextStyle}" FontSize="10"/>
                                                    <TextBlock Grid.Column="2" Text="1X2" Style="{StaticResource HeaderTextStyle}" FontSize="10"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="3" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <TextBlock Text="Lẻ/Chẵn" Style="{StaticResource HeaderTextStyle}"/>
                                        </Border>
                                        
                                        <Border Grid.Column="4" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <TextBlock Text="1X2" Style="{StaticResource HeaderTextStyle}"/>
                                        </Border>
                                        
                                        <Border Grid.Column="5" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Hiệp 1" Style="{StaticResource HeaderTextStyle}" Margin="0,2"/>
                                                <Grid Grid.Row="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="Cược chấp" Style="{StaticResource HeaderTextStyle}" FontSize="10"/>
                                                    <TextBlock Grid.Column="1" Text="Tài/Xỉu" Style="{StaticResource HeaderTextStyle}" FontSize="10"/>
                                                    <TextBlock Grid.Column="2" Text="1X2" Style="{StaticResource HeaderTextStyle}" FontSize="10"/>
                                                </Grid>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="6" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <TextBlock Text="Lẻ/Chẵn" Style="{StaticResource HeaderTextStyle}"/>
                                        </Border>
                                        
                                        <Border Grid.Column="7" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <TextBlock Text="1X2" Style="{StaticResource HeaderTextStyle}"/>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="8" Text="Nhiều" Style="{StaticResource HeaderTextStyle}"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Matches -->
                                <ItemsControl ItemsSource="{Binding Matches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="MatchBorder" Background="White" BorderBrush="#D0D8E0" BorderThickness="1,0,1,1">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    
                                                    <!-- Main Row with Teams -->
                                                    <Grid Grid.Row="0" MinHeight="35" Background="#F5F8FA">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60"/>
                                                            <ColumnDefinition Width="200"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        
                                                        <!-- Time and Status -->
                                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding TimeDisplay}" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        
                                                        <!-- Teams -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="5,0">
                                                            <TextBlock Text="{Binding HomeTeam}" FontWeight="Bold" Foreground="#C41E3A"/>
                                                            <TextBlock Text="Hòa" FontSize="10" Foreground="Gray" HorizontalAlignment="Center"/>
                                                            <TextBlock Text="{Binding AwayTeam}" FontWeight="Bold"/>
                                                        </StackPanel>
                                                        
                                                        <!-- Odds will be displayed here -->
                                                        <ContentPresenter Grid.Column="2" Content="{Binding}"/>
                                                    </Grid>
                                                    
                                                    <!-- Odds Rows -->
                                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding OddsGroups}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Background="#FAFBFC" BorderBrush="#E8EDF2" BorderThickness="0,1,0,0" Padding="5,3">
                                                                                <Grid>
                                                                                    <Grid.ColumnDefinitions>
                                                                                        <ColumnDefinition Width="60"/>
                                                                                        <ColumnDefinition Width="200"/>
                                                                                        <ColumnDefinition Width="*"/>
                                                                                    </Grid.ColumnDefinitions>
                                                                                    
                                                                                    <!-- Empty space for time/teams -->
                                                                                    <Border Grid.Column="0"/>
                                                                                    <Border Grid.Column="1"/>
                                                                                    
                                                                                    <!-- Odds Display -->
                                                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                                        <!-- Handicap/Line -->
                                                                                        <TextBlock Text="{Binding HandicapDisplay}" 
                                                                                                 FontWeight="Bold" 
                                                                                                 Foreground="#2E5090" 
                                                                                                 Width="60" 
                                                                                                 TextAlignment="Center"
                                                                                                 VerticalAlignment="Center"/>
                                                                                        
                                                                                        <!-- Home Odds -->
                                                                                        <Border Background="#E3F2FD" BorderBrush="#90CAF9" BorderThickness="1" 
                                                                                              Padding="8,3" Margin="5,0" MinWidth="50">
                                                                                            <TextBlock Text="{Binding HomeOddsDisplay}" 
                                                                                                     Foreground="{Binding HomeOdds, Converter={StaticResource OddsColorConverter}}"
                                                                                                     FontWeight="Bold"
                                                                                                     TextAlignment="Center"/>
                                                                                        </Border>
                                                                                        
                                                                                        <!-- Draw Odds (for 1X2) -->
                                                                                        <Border Background="#FFF9C4" BorderBrush="#FFF176" BorderThickness="1" 
                                                                                              Padding="8,3" Margin="5,0" MinWidth="50"
                                                                                              Visibility="{Binding DrawOddsDisplay, Converter={StaticResource StringVisibilityConverter}}">
                                                                                            <TextBlock Text="{Binding DrawOddsDisplay}" 
                                                                                                     FontWeight="Bold"
                                                                                                     TextAlignment="Center"/>
                                                                                        </Border>
                                                                                        
                                                                                        <!-- Away Odds -->
                                                                                        <Border Background="#FFE0B2" BorderBrush="#FFAB91" BorderThickness="1" 
                                                                                              Padding="8,3" Margin="5,0" MinWidth="50">
                                                                                            <TextBlock Text="{Binding AwayOddsDisplay}" 
                                                                                                     Foreground="{Binding AwayOdds, Converter={StaticResource OddsColorConverter}}"
                                                                                                     FontWeight="Bold"
                                                                                                     TextAlignment="Center"/>
                                                                                        </Border>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#2E5090" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="Đang khởi động..." Foreground="White" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
