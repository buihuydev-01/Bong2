<Window x:Class="BettingOddsDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BettingOddsDisplay.Converters"
        Title="Betting Odds Display" Height="900" Width="1600"
        Background="#E8EDF2">
    
    <Window.Resources>
        <converters:OddsColorConverter x:Key="OddsColorConverter"/>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
        
        <Style x:Key="HeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style x:Key="TeamTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="2,1"/>
        </Style>
        
        <Style x:Key="OddsButtonStyle" TargetType="Border">
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Status Bar -->
        <Border Grid.Row="0" Background="#2E5090" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="⚽ Cập nhật tự động mỗi giây" Foreground="White" FontWeight="Bold" FontSize="12"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="Cập nhật lúc: " Foreground="White" FontSize="11"/>
                    <TextBlock x:Name="UpdateTimeText" Text="--:--:--" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="5">
            <ItemsControl x:Name="LeaguesItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#B0C4D8" BorderThickness="1" Margin="0,0,0,5" CornerRadius="3">
                            <StackPanel>
                                <!-- League Header -->
                                <Border Background="#4A6FA5" Padding="8,5" CornerRadius="3,3,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="⭐" Foreground="#FFD700" FontSize="14" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold" FontSize="12"/>
                                        <TextBlock Text=" ⚽" Foreground="White" Margin="5,0" FontSize="12"/>
                                    </StackPanel>
                                </Border>
                                
                                <!-- Table Header -->
                                <Border Background="#2E5090" BorderBrush="#1E3F70" BorderThickness="0,1,0,1">
                                    <Grid Height="45">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>   <!-- Thời Gian -->
                                            <ColumnDefinition Width="180"/>  <!-- Trận đấu -->
                                            <ColumnDefinition Width="90"/>   <!-- Cược chấp -->
                                            <ColumnDefinition Width="70"/>   <!-- Tài/Xỉu -->
                                            <ColumnDefinition Width="90"/>   <!-- 1X2 -->
                                            <ColumnDefinition Width="90"/>   <!-- Hiệp 1 Cược chấp -->
                                            <ColumnDefinition Width="70"/>   <!-- Hiệp 1 Tài/Xỉu -->
                                            <ColumnDefinition Width="90"/>   <!-- Hiệp 1 1X2 -->
                                            <ColumnDefinition Width="50"/>   <!-- Nhiều -->
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Grid.Column="0" Text="Thời Gian" Style="{StaticResource HeaderTextStyle}"/>
                                        
                                        <Border Grid.Column="1" BorderBrush="#3A5A9A" BorderThickness="1,0">
                                            <TextBlock Text="Trận đấu" Style="{StaticResource HeaderTextStyle}"/>
                                        </Border>
                                        
                                        <Border Grid.Column="2" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Nguyên trận" Style="{StaticResource HeaderTextStyle}" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="1" Text="Cược chấp" Style="{StaticResource HeaderTextStyle}" FontSize="9" Margin="0,0,0,2"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="3" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text=" " Style="{StaticResource HeaderTextStyle}"/>
                                                <TextBlock Grid.Row="1" Text="Tài/Xỉu" Style="{StaticResource HeaderTextStyle}" FontSize="9"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="4" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text=" " Style="{StaticResource HeaderTextStyle}"/>
                                                <TextBlock Grid.Row="1" Text="1X2" Style="{StaticResource HeaderTextStyle}" FontSize="9"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="5" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="Hiệp 1" Style="{StaticResource HeaderTextStyle}" Margin="0,2,0,0"/>
                                                <TextBlock Grid.Row="1" Text="Cược chấp" Style="{StaticResource HeaderTextStyle}" FontSize="9" Margin="0,0,0,2"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="6" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text=" " Style="{StaticResource HeaderTextStyle}"/>
                                                <TextBlock Grid.Row="1" Text="Tài/Xỉu" Style="{StaticResource HeaderTextStyle}" FontSize="9"/>
                                            </Grid>
                                        </Border>
                                        
                                        <Border Grid.Column="7" BorderBrush="#3A5A9A" BorderThickness="0,0,1,0">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text=" " Style="{StaticResource HeaderTextStyle}"/>
                                                <TextBlock Grid.Row="1" Text="1X2" Style="{StaticResource HeaderTextStyle}" FontSize="9"/>
                                            </Grid>
                                        </Border>
                                        
                                        <TextBlock Grid.Column="8" Text="Nhiều" Style="{StaticResource HeaderTextStyle}"/>
                                    </Grid>
                                </Border>
                                
                                <!-- Matches -->
                                <ItemsControl ItemsSource="{Binding Matches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#FAFBFC" BorderBrush="#D0D8E0" BorderThickness="0,0,0,1">
                                                <Grid MinHeight="80">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="70"/>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    
                                                    <!-- Time Column -->
                                                    <Border Grid.Column="0" Background="#F0F4F8" BorderBrush="#E0E8F0" BorderThickness="0,0,1,0">
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                            <TextBlock Text="{Binding TimeDisplay}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" Foreground="#2E5090"/>
                                                            <TextBlock Text="{Binding StatusDisplay}" Foreground="Red" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Border>
                                                    
                                                    <!-- Teams Column -->
                                                    <Border Grid.Column="1" Background="#F8FAFB" BorderBrush="#E0E8F0" BorderThickness="0,0,1,0" Padding="5">
                                                        <Grid VerticalAlignment="Center">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            
                                                            <TextBlock Grid.Row="0" Text="{Binding HomeTeam}" Style="{StaticResource TeamTextStyle}" Foreground="#C41E3A"/>
                                                            <TextBlock Grid.Row="1" Text="Hòa" FontSize="9" Foreground="Gray" HorizontalAlignment="Center" Margin="0,1"/>
                                                            <TextBlock Grid.Row="2" Text="{Binding AwayTeam}" Style="{StaticResource TeamTextStyle}" Foreground="#0050A0"/>
                                                        </Grid>
                                                    </Border>
                                                    
                                                    <!-- Odds Columns -->
                                                    <Grid Grid.Column="2" Background="White">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                            <ItemsControl ItemsSource="{Binding OddsGroups}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <ItemsControl ItemsSource="{Binding Lines}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Border BorderBrush="#E8EDF2" BorderThickness="0,1,0,0" Padding="8,4" Background="#FCFDFE">
                                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                                                                            <!-- Handicap Label -->
                                                                                            <Border Background="#E8EDF2" BorderBrush="#D0D8E0" BorderThickness="1" 
                                                                                                  Style="{StaticResource OddsButtonStyle}" MinWidth="50">
                                                                                                <TextBlock Text="{Binding HandicapDisplay}" 
                                                                                                         FontWeight="Bold" 
                                                                                                         Foreground="#2E5090" 
                                                                                                         TextAlignment="Center"
                                                                                                         FontSize="11"/>
                                                                                            </Border>
                                                                                            
                                                                                            <!-- Home Odds -->
                                                                                            <Border Background="#E3F2FD" BorderBrush="#90CAF9" 
                                                                                                  Style="{StaticResource OddsButtonStyle}" MinWidth="55">
                                                                                                <TextBlock Text="{Binding HomeOddsDisplay}" 
                                                                                                         Foreground="{Binding HomeOdds, Converter={StaticResource OddsColorConverter}}"
                                                                                                         FontWeight="Bold"
                                                                                                         TextAlignment="Center"
                                                                                                         FontSize="11"/>
                                                                                            </Border>
                                                                                            
                                                                                            <!-- Draw Odds (if exists) -->
                                                                                            <Border Background="#FFF9C4" BorderBrush="#FFF176" 
                                                                                                  Style="{StaticResource OddsButtonStyle}" MinWidth="55"
                                                                                                  Visibility="{Binding DrawOddsDisplay, Converter={StaticResource StringVisibilityConverter}}">
                                                                                                <TextBlock Text="{Binding DrawOddsDisplay}" 
                                                                                                         FontWeight="Bold"
                                                                                                         TextAlignment="Center"
                                                                                                         FontSize="11"/>
                                                                                            </Border>
                                                                                            
                                                                                            <!-- Away Odds -->
                                                                                            <Border Background="#FFE0B2" BorderBrush="#FFAB91" 
                                                                                                  Style="{StaticResource OddsButtonStyle}" MinWidth="55">
                                                                                                <TextBlock Text="{Binding AwayOddsDisplay}" 
                                                                                                         Foreground="{Binding AwayOdds, Converter={StaticResource OddsColorConverter}}"
                                                                                                         FontWeight="Bold"
                                                                                                         TextAlignment="Center"
                                                                                                         FontSize="11"/>
                                                                                            </Border>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#2E5090" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Đang khởi động..." Foreground="White" FontWeight="Bold" FontSize="11"/>
                <TextBlock Grid.Column="1" Text="© 2025 Betting Odds Display" Foreground="#B0C4D8" FontSize="10" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
