<Window x:Class="BettingOddsDisplay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:BettingOddsDisplay.Converters"
        Title="Betting Odds Display" Height="900" Width="1800"
        Background="#E8EDF2">
    
    <Window.Resources>
        <converters:OddsColorConverter x:Key="OddsColorConverter"/>
        <converters:StringVisibilityConverter x:Key="StringVisibilityConverter"/>
        
        <!-- Table Cell Style -->
        <Style x:Key="CellBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#B0C4D8"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="3,2"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        
        <Style x:Key="HeaderBorder" TargetType="Border">
            <Setter Property="Background" Value="#2E5090"/>
            <Setter Property="BorderBrush" Value="#1E3F70"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>
        
        <Style x:Key="HeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        
        <Style x:Key="OddsText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Status Bar -->
        <Border Grid.Row="0" Background="#2E5090" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚽ Cập nhật tự động" Foreground="White" FontWeight="Bold" FontSize="12"/>
                <TextBlock x:Name="UpdateTimeText" Grid.Column="1" Text="--:--:--" Foreground="#FFD700" FontWeight="Bold" FontSize="11"/>
            </Grid>
        </Border>
        
        <!-- Main Table -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Table Header -->
                <Grid Background="#2E5090" Height="45">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>    <!-- Time -->
                        <ColumnDefinition Width="150"/>   <!-- Match -->
                        <ColumnDefinition Width="80"/>    <!-- Handicap Label -->
                        <ColumnDefinition Width="80"/>    <!-- Home -->
                        <ColumnDefinition Width="80"/>    <!-- Draw -->
                        <ColumnDefinition Width="80"/>    <!-- Away -->
                        <ColumnDefinition Width="80"/>    <!-- H1 Handicap Label -->
                        <ColumnDefinition Width="80"/>    <!-- H1 Home -->
                        <ColumnDefinition Width="80"/>    <!-- H1 Away -->
                        <ColumnDefinition Width="50"/>    <!-- More -->
                    </Grid.ColumnDefinitions>
                    
                    <Border Grid.Column="0" Style="{StaticResource HeaderBorder}">
                        <TextBlock Text="Thời Gian" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource HeaderBorder}">
                        <TextBlock Text="Trận đấu" Style="{StaticResource HeaderText}"/>
                    </Border>
                    <Border Grid.Column="2" Grid.ColumnSpan="4" Style="{StaticResource HeaderBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Nguyên trận" Style="{StaticResource HeaderText}" Margin="0,0,0,2"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cược chấp" Style="{StaticResource HeaderText}" FontSize="8"/>
                                <TextBlock Grid.Column="1" Text="Tài/Xỉu" Style="{StaticResource HeaderText}" FontSize="8"/>
                                <TextBlock Grid.Column="2" Text="1X2" Style="{StaticResource HeaderText}" FontSize="8"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="6" Grid.ColumnSpan="3" Style="{StaticResource HeaderBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Hiệp 1" Style="{StaticResource HeaderText}" Margin="0,0,0,2"/>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Cược chấp" Style="{StaticResource HeaderText}" FontSize="8"/>
                                <TextBlock Grid.Column="1" Text="Tài/Xỉu" Style="{StaticResource HeaderText}" FontSize="8"/>
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Column="9" Style="{StaticResource HeaderBorder}">
                        <TextBlock Text="+" Style="{StaticResource HeaderText}"/>
                    </Border>
                </Grid>
                
                <!-- Matches List -->
                <ItemsControl x:Name="MatchesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="#B0C4D8" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Main row with teams -->
                                        <RowDefinition Height="Auto"/>  <!-- Odds lines -->
                                    </Grid.RowDefinitions>
                                    
                                    <!-- Main Row -->
                                    <Grid Grid.Row="0" MinHeight="35">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Time -->
                                        <Border Grid.Column="0" Style="{StaticResource CellBorder}" Background="#F0F4F8">
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <TextBlock Text="{Binding TimeDisplay}" FontWeight="Bold" FontSize="11" Foreground="#2E5090"/>
                                                <TextBlock Text="{Binding StatusDisplay}" FontSize="9" Foreground="Red" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        
                                        <!-- Teams -->
                                        <Border Grid.Column="1" Style="{StaticResource CellBorder}" Background="#F8FAFB">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                    <RowDefinition/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Row="0" Text="{Binding HomeTeam}" FontWeight="Bold" FontSize="10" Foreground="#C41E3A" Margin="2,1"/>
                                                <TextBlock Grid.Row="1" Text="Hòa" FontSize="8" Foreground="Gray" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Row="2" Text="{Binding AwayTeam}" FontWeight="Bold" FontSize="10" Foreground="#0050A0" Margin="2,1"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    
                                    <!-- Odds Lines (multiple rows) -->
                                    <ItemsControl Grid.Row="1" ItemsSource="{Binding OddsGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ItemsControl ItemsSource="{Binding Lines}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Height="22" Background="White">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="70"/>
                                                                    <ColumnDefinition Width="150"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="80"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                
                                                                <!-- Empty time/team cells -->
                                                                <Border Grid.Column="0" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0"/>
                                                                <Border Grid.Column="1" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0"/>
                                                                
                                                                <!-- Handicap Label -->
                                                                <Border Grid.Column="2" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0" Background="#FAFBFC">
                                                                    <TextBlock Text="{Binding HandicapDisplay}" 
                                                                             Style="{StaticResource OddsText}"
                                                                             Foreground="#2E5090"/>
                                                                </Border>
                                                                
                                                                <!-- Home Odds -->
                                                                <Border Grid.Column="3" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0" Background="#E3F2FD">
                                                                    <TextBlock Text="{Binding HomeOddsDisplay}" 
                                                                             Style="{StaticResource OddsText}"
                                                                             Foreground="{Binding HomeOdds, Converter={StaticResource OddsColorConverter}}"/>
                                                                </Border>
                                                                
                                                                <!-- Draw Odds (for 1X2) -->
                                                                <Border Grid.Column="4" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0" Background="#FFF9C4"
                                                                      Visibility="{Binding DrawOddsDisplay, Converter={StaticResource StringVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding DrawOddsDisplay}" 
                                                                             Style="{StaticResource OddsText}"/>
                                                                </Border>
                                                                
                                                                <!-- Away Odds -->
                                                                <Border Grid.Column="5" BorderBrush="#E8EDF2" BorderThickness="0,0,1,0" Background="#FFE0B2">
                                                                    <TextBlock Text="{Binding AwayOddsDisplay}" 
                                                                             Style="{StaticResource OddsText}"
                                                                             Foreground="{Binding AwayOdds, Converter={StaticResource OddsColorConverter}}"/>
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="#2E5090" Padding="10,5">
            <TextBlock x:Name="StatusText" Text="Đang khởi động..." Foreground="White" FontWeight="Bold" FontSize="11"/>
        </Border>
    </Grid>
</Window>
